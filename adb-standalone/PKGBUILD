# Maintainer: MeowArchMobile
# adb-standalone — AOSP's host adb client, built standalone.
#
# Runs in place next to a checkout of the AOSP tree (../aosp-adbd, shared with
# adbd-standalone and better_fastboot). Build first:
#
#   cmake -B build-native -G Ninja -DCMAKE_BUILD_TYPE=RelWithDebInfo \
#         -DCMAKE_C_COMPILER=clang -DCMAKE_CXX_COMPILER=clang++
#   cmake --build build-native -j$(nproc)
#   makepkg -f
#
# Layout: the binary lives in /usr/lib/adb-meowarch/ and two symlinks in
# /usr/bin point at it — `adb-m` (short, primary) and `adb-meowarch` (the
# original, kept as an alias so existing scripts and muscle memory keep
# working). Nothing collides with the distro's android-tools, which keeps owning
# /usr/bin/adb; both packages install side by side.

pkgname=adb-meowarch
pkgver=36.0.0
pkgrel=3
pkgdesc="AOSP host adb client (platform-tools adb), built standalone against Arch's libusb"
arch=('x86_64')
url="https://android.googlesource.com/platform/packages/modules/adb/"
license=('Apache')
depends=('glibc' 'gcc-libs' 'libc++' 'libc++abi' 'zlib' 'lz4' 'zstd'
         'brotli' 'libusb' 'systemd-libs')
makedepends=('cmake' 'clang' 'ninja' 'pkgconf' 'git')
optdepends=('android-udev: udev rules so adb sees phones without root')
install=adb.install
options=(!strip)

package() {
    local root
    root="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)"
    local libdir="$pkgdir/usr/lib/adb-meowarch"

    install -Dm755 "$root/build-native/adb" "$libdir/adb"

    # Two command names, one binary: adb-m (short, primary) and adb-meowarch
    # (the original, kept as an alias). The package name stays adb-meowarch so
    # upgrades are seamless.
    install -d "$pkgdir/usr/bin"
    ln -s ../lib/adb-meowarch/adb "$pkgdir/usr/bin/adb-m"
    ln -s ../lib/adb-meowarch/adb "$pkgdir/usr/bin/adb-meowarch"

    # Completions are generated by the binary itself (--shell-completion=), so
    # they cannot drift from the option list. One script per command name per
    # shell: both names must complete, since both are real executables.
    local shell dir name
    for shell in bash zsh fish; do
        for name in adb-m adb-meowarch; do
            case "$shell" in
                bash) dir=usr/share/bash-completion/completions; file="$name" ;;
                zsh)  dir=usr/share/zsh/site-functions;          file="_$name" ;;
                fish) dir=usr/share/fish/vendor_completions.d;   file="$name.fish" ;;
            esac
            "$root/build-native/adb" --shell-completion="$shell" "$name" |
                install -Dm644 /dev/stdin "$pkgdir/$dir/$file"
        done
    done
}

