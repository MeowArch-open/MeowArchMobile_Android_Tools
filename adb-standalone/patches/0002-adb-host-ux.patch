+// MeowArchMobile: `adb devices` with colour. State words map to a colour:
+// device -> green, unauthorized/offline -> yellow, anything else -> dim.
+static int adb_devices_command(const std::string& command) {
+    std::string result;
+    std::string error;
+    if (!adb_query(command, &result, &error)) {
+        fprintf(stderr, "%s%s\n", fbcolor::Paint(fbcolor::C::Red, "error: ").c_str(),
+                error.c_str());
+        return 1;
+    }
+    size_t start = 0;
+    while (start < result.size()) {
+        size_t nl = result.find('\n', start);
+        std::string line = result.substr(start, nl == std::string::npos ? std::string::npos
+                                                                      : nl - start);
+        size_t tab = line.find('\t');
+        if (tab == std::string::npos) {
+            printf("%s\n", line.c_str());
+        } else {
+            std::string serial = line.substr(0, tab);
+            std::string rest = line.substr(tab + 1);
+            size_t sp = rest.find(' ');
+            std::string state = rest.substr(0, sp);
+            std::string tail = sp == std::string::npos ? "" : rest.substr(sp);
+            fbcolor::C c = fbcolor::C::Dim;
+            if (state == "device") c = fbcolor::C::Green;
+            else if (state == "unauthorized" || state == "offline" || state == "recovery" ||
+                     state == "sideload" || state == "bootloader")
+                c = fbcolor::C::Yellow;
+            printf("%s\t%s%s%s%s\n", serial.c_str(),
+                   fbcolor::Code(c), state.c_str(), fbcolor::Code(fbcolor::C::Reset),
+                   tail.c_str());
+        }
+        if (nl == std::string::npos) break;
+        start = nl + 1;
+    }
+    return 0;
+}
