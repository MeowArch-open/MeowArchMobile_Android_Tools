+// MeowArchMobile: `adb devices` with colour. State words map to a colour:
+// device -> green, unauthorized/offline -> yellow, anything else -> dim.
+static int adb_devices_command(const std::string& command) {
+    std::string result;
+    std::string error;
+    if (!adb_query(command, &result, &error)) {
+        fprintf(stderr, "%s%s\n", fbcolor::Paint(fbcolor::C::Red, "error: ").c_str(),
+                error.c_str());
+        return 1;
+    }
+    size_t start = 0;
+    while (start < result.size()) {
+        size_t nl = result.find('\n', start);
+        std::string line = result.substr(start, nl == std::string::npos ? std::string::npos
+                                                                      : nl - start);
+        // Two layouts come back from the server: plain `devices` sends
+        // "<serial>\t<state>", `devices -l` sends "<serial><padding>device
+        // transport_id:N ...". Split on the first run of whitespace either way,
+        // so both get coloured and neither loses its original spacing.
+        size_t sep = line.find_first_of(" \t");
+        if (sep == std::string::npos) {
+            printf("%s\n", line.c_str());
+        } else {
+            std::string serial = line.substr(0, sep);
+            size_t state_beg = line.find_first_not_of(" \t", sep);
+            if (state_beg == std::string::npos) {
+                printf("%s\n", line.c_str());
+            } else {
+                size_t state_end = line.find_first_of(" \t", state_beg);
+                std::string state = line.substr(state_beg, state_end == std::string::npos
+                                                              ? std::string::npos
+                                                              : state_end - state_beg);
+                fbcolor::C c = fbcolor::C::Dim;
+                if (state == "device") c = fbcolor::C::Green;
+                else if (state == "unauthorized" || state == "offline" ||
+                         state == "recovery" || state == "sideload" ||
+                         state == "bootloader")
+                    c = fbcolor::C::Yellow;
+                // Print the original bytes around the state word verbatim (the
+                // padding IS part of the layout), inserting only the escapes.
+                fwrite(line.data(), 1, state_beg, stdout);
+                fputs(fbcolor::Code(c), stdout);
+                fwrite(state.data(), 1, state.size(), stdout);
+                fputs(fbcolor::Code(fbcolor::C::Reset), stdout);
+                if (state_end != std::string::npos) {
+                    fputs(line.c_str() + state_end, stdout);
+                }
+                putchar('\n');
+            }
+        }
+        if (nl == std::string::npos) break;
+        start = nl + 1;
+    }
+    // Upstream prints this listing through adb_query_command, which does
+    // printf("%s\n", result) on a string that already ends in a newline — so
+    // the output carries one trailing blank line. Reproduce it exactly: piped
+    // output must be byte-identical, and scripts do tail that line.
+    putchar('\n');
+    return 0;
+}
